# Server-side OpenRouter key is optional. Users can also connect a temporary key in the UI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Korean Tourism Organization GoCamping API service key.
GOCAMPING_SERVICE_KEY=

# Mapbox Directions, Isochrone, and optional map style.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAP_STYLE_URL=

# Absolute deployed origin used in share and social links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
