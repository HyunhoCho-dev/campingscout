# Required for live GPT-5.6 planning. The app remains fully usable in demo mode without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Korean Tourism Organization GoCamping API service key.
GOCAMPING_SERVICE_KEY=

# Mapbox Directions, Isochrone, and optional map style.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAP_STYLE_URL=

# Absolute deployed origin used in share and social links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
